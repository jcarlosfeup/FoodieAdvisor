# Frontend settings (Vite reads frontend/.env*). Copy to .env.local to override. All optional.

# Base URL of the API as seen by the browser. Empty = same origin (Vite dev proxy / nginx).
# VITE_API_BASE_URL=

# Map tiles. The OSM standard tiles are fine for development; use a provider whose terms and
# capacity fit public traffic before deploying. Keep the OpenStreetMap attribution.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Dev server only: where /api and /health are proxied.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
