# Copy to .env and set a non-default password. Never commit .env.
POSTGRES_DB=foodie
POSTGRES_USER=foodie
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Used by host-side tools (collector, dbt, API dev server). Inside Compose the host is "db".
DATABASE_URL=postgresql+psycopg://foodie:change-this-local-password@localhost:5432/foodie

# Optional: integration tests create and drop a temporary database on this server.
# Point it at the server's maintenance database, never at shared or production data.
# TEST_DATABASE_URL=postgresql+psycopg://foodie:change-this-local-password@localhost:5432/postgres

# Collector (defaults shown). Downloads are cached under DATA_DIR, which is gitignored.
# DATA_DIR=data
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_QUERY_TIMEOUT_SECONDS=90
# OVERPASS_REQUEST_DELAY_SECONDS=5
# DEFAULT_RADIUS_KM=5
# GEONAMES_BASE_URL=https://download.geonames.org/export/dump
# GEONAMES_CITIES_FILE=cities5000
# HTTP_USER_AGENT=FoodieAdvisor-collector/0.1 (personal portfolio project)
# HTTP_TIMEOUT_SECONDS=60
# HTTP_MAX_ATTEMPTS=4
# HTTP_BACKOFF_SECONDS=2

# API (defaults shown). API_CORS_ORIGINS is a JSON list of browser origins allowed to call the API.
# API_HOST=127.0.0.1
# API_PORT=8000
# API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# API_DEFAULT_LIMIT=100
# API_MAX_LIMIT=500
# API_MAX_BBOX_SPAN_DEGREES=2

# Google Places lab only (optional). Keep the service-account key under secrets/, which is gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
