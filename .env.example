# Copy to .env and set a non-default password. Never commit .env.
POSTGRES_DB=foodie
POSTGRES_USER=foodie
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Used by host-side tools (collector, dbt, API dev server). Inside Compose the host is "db".
DATABASE_URL=postgresql+psycopg://foodie:change-this-local-password@localhost:5432/foodie

# Google Places lab only (optional). Keep the key under secrets/, which is gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
